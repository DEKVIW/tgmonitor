[Unit]
Description=TG Monitor Resource Ops Worker
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/data/python/tg-monitor
Environment="PATH=/root/data/python/tg-monitor/tgmonitor-venv/bin"
Environment="PYTHONPATH=/root/data/python/tg-monitor"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/root/data/python/tg-monitor/tgmonitor-venv/bin/python -m app.worker.main
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
