[Unit]
Description=TG Monitor API (FastAPI)
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/data/python/tg-monitor
Environment="PATH=/root/data/python/tg-monitor/tgmonitor-venv/bin"
Environment="PYTHONPATH=/root/data/python/tg-monitor"
Environment="PYTHONUNBUFFERED=1"
# Keep a single worker here because FastAPI startup launches in-process schedulers.
ExecStart=/root/data/python/tg-monitor/tgmonitor-venv/bin/uvicorn app.api.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
