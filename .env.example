# Telegram
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL_ASYNC=postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# Default monitored channels, comma separated, without @
DEFAULT_CHANNELS=CHANNEL1,CHANNEL2,CHANNEL3

# App settings
LOG_LEVEL=INFO
DOCKER_ENV=true
SECRET_SALT=YOUR_SECRET_SALT
FRONTEND_URL=http://localhost:3000
PUBLIC_DASHBOARD_ENABLED=false


DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_ASYNC_POOL_SIZE=1
DB_ASYNC_MAX_OVERFLOW=1
MONITOR_URL_RESOLUTION_CACHE_MAX_ENTRIES=10000
LINK_CHECK_RESULT_CACHE_MAX_ENTRIES=15000